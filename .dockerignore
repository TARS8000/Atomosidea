# Root build context (context: .) is used by every backend service and SFSP.
# Their Dockerfiles do `COPY . .` and need backend/shared plus their own module,
# so never exclude backend/<service>/ source directories here.
# The frontend builds with context ./frontend and uses frontend/.dockerignore instead.

# Git / IDE / tooling
.git
.gitignore
.idea
.vscode
*.iml
.kilo
.cursor

# Secrets: runtime config comes from docker-compose `environment:`, never from the image
.env
.env.*
!.env.example

# Node.js dependencies and frontend build outputs (not needed by any root-context build)
**/node_modules
frontend/node_modules
frontend/dist
monitoring-service/frontend/node_modules
monitoring-service/frontend/dist

# Runtime data (bind-mounted volumes, not image content)
backend/storage_data
backend/video-service/upload_workdir

# Large media / archives that may be dropped locally for testing
**/*.mp4
**/*.mov
**/*.mkv
**/*.webm
**/*.avi
**/*.zip
