{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "s3:ListAllMyBuckets",
                "s3:GetBucketLocation",
                "s3:CreateBucket"
            ],
            "Resource": "arn:aws:s3:::*"
        },
        {
            "Effect": "Allow",
            "Action": [
                "s3:*"
            ],
            "Resource": [
                "arn:aws:s3:::clean-files",
                "arn:aws:s3:::clean-files/*",
                "arn:aws:s3:::quarantine",
                "arn:aws:s3:::quarantine/*",
                "arn:aws:s3:::raw-files",
                "arn:aws:s3:::raw-files/*"
            ]
        }
    ]
}