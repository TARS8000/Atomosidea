# PostgreSQL Database Settings
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=movie_db

# Application Settings
JWT_SECRET=your-super-secret-and-long-random-string
UPLOAD_DIR=/storage/videos
THUMBNAIL_DIR=/storage/thumbnails
APP_URL=http://localhost:3001

# Static Site Hosting
# The base domain for hosting static sites. e.g., if set to "localhost",
# a site with ID "my-cool-site" will be available at "my-cool-site.localhost:3001".
STATIC_SITE_DOMAIN=localhost

# Admin Registration Code (keep this secret!)
ADMIN_REGISTRATION_CODE="your-secret-admin-code"

# Google OAuth2 Settings
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- MinIO Settings ---
MINIO_USE_SSL=false

# Game Storage (MinIO)
GAME_MINIO_ACCESS_KEY_ID=your-minio-access-key
GAME_MINIO_SECRET_ACCESS_KEY=your-minio-secret-key

# Profile Storage (MinIO)
PROFILE_MINIO_ACCESS_KEY_ID=your-minio-access-key
PROFILE_MINIO_SECRET_ACCESS_KEY=your-minio-secret-key

# Static Site Storage (MinIO)
STATIC_SITE_MINIO_ACCESS_KEY_ID=your-minio-access-key
STATIC_SITE_MINIO_SECRET_ACCESS_KEY=your-minio-secret-key

# Redis (Job Queue) Settings
REDIS_ADDR=redis:6379
REDIS_PASSWORD=""
REDIS_DB=0

# --- SFSP (Secure File Scanning Platform) Settings ---
SFSP_API_URL=http://sfsp-api:8080
SFSP_MINIO_ACCESS_KEY_ID=your-sfsp-minio-access-key
SFSP_MINIO_SECRET_ACCESS_KEY=your-sfsp-minio-secret-key

# Scanner Docker Images (can be overridden)
# SFSP_SCANNER_CLAMAV_IMAGE=your-repo/sfsp-clamav-client:latest
# SFSP_SCANNER_YARA_IMAGE=your-repo/sfsp-yara-client:latest

# Path to YARA rules file inside the worker container
# SFSP_SCANNER_YARA_RULES_PATH=/etc/yara-rules/my_rules.yar