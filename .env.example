# PostgreSQL Database Settings
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password-123
POSTGRES_DB=movie_db

# Passwords for service-specific DB roles (db-role-init が起動のたびに各 DB のロールへ反映する。変更は .env を書き換えて up するだけ)
AUTH_SERVICE_DB_PASSWORD=change-me-auth-service-db-password
MYPAGE_SERVICE_DB_PASSWORD=change-me-mypage-service-db-password
TEAM_SERVICE_DB_PASSWORD=change-me-team-service-db-password
# app-db の読み取り専用ロール sfsp_worker（sfsp-worker が使用）
SFSP_WORKER_DB_PASSWORD=change-me-sfsp-worker-db-password

# Application Settings
JWT_SECRET=your-super-secret-and-long-random-string
UPLOAD_DIR=/storage/videos
THUMBNAIL_DIR=/storage/thumbnails
APP_URL=http://localhost:3001

# Static Site Hosting
STATIC_SITE_DOMAIN=localhost

# Admin Registration Code
ADMIN_REGISTRATION_CODE="your-secret-admin-code"

# Google OAuth2 Settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MinIO Settings ---
MINIO_USE_SSL=false

# MinIO Root Credentials (root user for admin/console access)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword

# 各サービス用の MinIO ユーザー（minio-init が作成し、各自のバケットのみ操作可能なポリシーを付与）
# Game Storage (MinIO)
GAME_MINIO_ACCESS_KEY_ID=your-game-minio-access-key
GAME_MINIO_SECRET_ACCESS_KEY=your-game-minio-secret-key-123

# Profile Storage (MinIO)
PROFILE_MINIO_ACCESS_KEY_ID=your-profile-minio-access-key
PROFILE_MINIO_SECRET_ACCESS_KEY=your-profile-minio-secret-key-123

# Video Storage (MinIO)
VIDEO_MINIO_ACCESS_KEY_ID=your-video-minio-access-key
VIDEO_MINIO_SECRET_ACCESS_KEY=your-video-minio-secret-key-123

# Static Site Storage (MinIO)
STATIC_SITE_MINIO_ACCESS_KEY_ID=your-static-site-minio-access-key
STATIC_SITE_MINIO_SECRET_ACCESS_KEY=your-static-site-minio-secret-key-123

# Redis (Job Queue) Settings — パスワード必須（requirepass）。URL に埋め込むため英数字のみ（openssl rand -hex 32 など）
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change-me-redis-password-hex
REDIS_DB=0

# --- SFSP (Secure File Scanning Platform) Settings ---
SFSP_API_URL=http://sfsp-api:8080
# sfsp-api の認証キー（ヘッダー X-SFSP-API-Key）
SFSP_API_KEY=change-me-sfsp-api-key

# SFSP MinIO Credentials for upload-service (raw-minio)
SFSP_UPLOAD_ACCESS_KEY=sfsp-upload-access-key
SFSP_UPLOAD_SECRET_KEY=sfsp-upload-secret-key-123

# SFSP MinIO Credentials for sfsp-worker (raw-minio)
SFSP_WORKER_RAW_ACCESS_KEY=sfsp-worker-raw-access-key
SFSP_WORKER_RAW_SECRET_KEY=sfsp-worker-raw-secret-key-123

# SFSP MinIO Credentials for sfsp-worker (clean-minio)
SFSP_WORKER_CLEAN_ACCESS_KEY=sfsp-worker-clean-access-key
SFSP_WORKER_CLEAN_SECRET_KEY=sfsp-worker-clean-secret-key-123

# SFSP MinIO Credentials for sfsp-api (raw-files への書き込み用)
SFSP_API_ACCESS_KEY=sfsp-api-access-key
SFSP_API_SECRET_KEY=sfsp-api-secret-key-123

# SFSP MinIO Credentials for game-worker (clean-minio)
SFSP_GAME_WORKER_ACCESS_KEY=sfsp-game-worker-access-key
SFSP_GAME_WORKER_SECRET_KEY=sfsp-game-worker-secret-key-123

# SFSP MinIO Credentials for static-site-worker (clean-minio)
SFSP_STATIC_SITE_WORKER_ACCESS_KEY=sfsp-static-site-worker-access-key
SFSP_STATIC_SITE_WORKER_SECRET_KEY=sfsp-static-site-worker-secret-key-123

# SFSP MinIO Credentials for profile-worker (clean-minio)
SFSP_PROFILE_WORKER_ACCESS_KEY=sfsp-profile-worker-access-key
SFSP_PROFILE_WORKER_SECRET_KEY=sfsp-profile-worker-secret-key-123

# SFSP MinIO Credentials for video-worker (clean-minio)
SFSP_VIDEO_WORKER_ACCESS_KEY=sfsp-video-worker-access-key
SFSP_VIDEO_WORKER_SECRET_KEY=sfsp-video-worker-secret-key-123

CACHE_BUSTER=2

# --- Internal service-to-service API key (header X-Internal-Key) ---
INTERNAL_API_KEY=change-me-internal-api-key

# --- Upload size limits (bytes) ---
MAX_VIDEO_UPLOAD_BYTES=1073741824
MAX_GAME_UPLOAD_BYTES=1073741824
MAX_SITE_UPLOAD_BYTES=524288000
MAX_IMAGE_UPLOAD_BYTES=10485760

# --- Monitoring dashboard (monitoring-service, http://127.0.0.1:8090) login (HTTP Basic) ---
MONITOR_USERNAME=admin
MONITOR_PASSWORD=change-me-monitor-password
# Optional: extra Host header values the monitoring dashboard accepts, comma separated (empty = localhost / 127.0.0.1 / ::1 only)
MONITORING_ALLOWED_HOSTS=

# Optional: pin the docker compose project name. Without it the name comes from the folder name; moving or renaming the folder then creates a separate project with new, empty DB volumes.
# COMPOSE_PROJECT_NAME=atomosidea
