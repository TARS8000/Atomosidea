# IDE - specific
.idea/
.vscode/
*.iml

# Dependencies
node_modules/

# Build outputs
/build/
/dist/
*.exe
*.out

# Unified MinIO object storage (single host directory, bucket-separated internally)
/backend/storage_data/

# Environment files
# Contains sensitive credentials and local settings.
# A .env.example file should be committed instead.
.env
.env.*
!.env.example

# Log files
*.log
logs/
.aider*

# Frontend build outputs
frontend/dist/

# OS junk
Thumbs.db
.DS_Store
Desktop.ini

# Editor swap files
*.swp
*.swo
*~

# Generated by the monitoring dashboard build (mon-frontend writes it, mon-nginx serves it)
monitoring-service/frontend/dist/

# Video transcoding scratch directory (bind-mounted into video-upload-api)
/backend/video-service/upload_workdir/

# Binaries written by `go build` when run inside a service directory
/backend/profile-service/mypage-worker/mypage-service
/backend/profile-service/profile-worker/profile-service
/backend/video-service/video-upload-api/upload-service
/backend/video-service/video-worker/stream-service
