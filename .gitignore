# IDE - specific
.idea/
.vscode/
*.iml

# Dependencies
node_modules/

# Build outputs
/build/
/dist/
*.exe
*.out

# Local Docker data volumes
# These directories are generated locally to store persistent data for databases and storage.
/auth_db_data/
/app_db_data/
/profile_db_data/
/sfsp_db_data/
backend/auth/auth_storage_db/
backend/profile-service/profile_storage_db/
backend/video-service/video_storage_db/
backend/static-site-service/static_site_storage_db/
/sfsp_minio_data/
/sfsp_raw_minio_data/
/sfsp_clean_minio_data/
/test_field/

# Unified MinIO object storage (single host directory, bucket-separated internally)
/backend/storage_data/

# Deprecated local storage folders (if any)
/backend/datebase/app_storage_db/

# Environment files
# Contains sensitive credentials and local settings.
# A .env.example file should be committed instead.
.env
.env.*
!.env.example

# Log files
*.log
logs/
.aider*

# Frontend build outputs
frontend/dist/

# MinIO client binaries
mc-linux

